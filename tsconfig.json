{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "ws", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./web/*"]
    }
  },
  "include": ["src", "web", "vite.config.ts"]
}
